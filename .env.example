# Bearer token for the board API
WISSEL_API_TOKEN=

# Token passed through to per-session claude-mem MCP config
WISSEL_CLAUDE_MEM_TOKEN=
WISSEL_CLAUDE_MEM_URL=

# Where wissel's CLI looks for a running daemon
WISSEL_API_URL=http://localhost:8787

# Where the dispatch/cost telemetry log is written
WISSEL_TELEMETRY_PATH=~/.wissel/telemetry.jsonl

# Set to 1 to route tasks automatically as they appear. Read-only agents
# run in-process; write-tier agents are only decided and handed off —
# wissel never spawns or supervises execution itself.
WISSEL_ORCHESTRATOR=

# Set to 1 to have wissel run write-tier work itself instead of only
# dispatching it for an external runner like agetor — headless
# `claude -p` with --permission-mode acceptEdits, against the task's
# repo. Only takes effect when WISSEL_ORCHESTRATOR=1. A write-tier
# success still lands in `review`, never `done`, either way.
WISSEL_EXECUTE_WRITE_TIER=

# API key(s) for agents/skills whose manifest entry sets `executor: api`
# — a direct call to the Anthropic Messages API (no claude-cli, no file
# or tool access, just a question in and an answer out). Auto-detected
# at startup the same way claude-cli accounts are: any ANTHROPIC_API_KEY
# or ANTHROPIC_API_KEY_<NAME> variable that's set becomes a harness.
# Never commit a real key here or in harnesses.yaml — only the env var
# NAME belongs in harnesses.yaml, never the value.
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_PERSONAL=
