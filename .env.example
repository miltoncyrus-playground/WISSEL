# Bearer token for the board API
WISSEL_API_TOKEN=

# Token passed through to per-session claude-mem MCP config
WISSEL_CLAUDE_MEM_TOKEN=
WISSEL_CLAUDE_MEM_URL=

# Where worktrees are created
WISSEL_WORKTREE_ROOT=~/.wissel/worktrees

# Set to 1 to route and run tasks automatically. Off by default: this
# spawns write-tier agents with full permission bypass in a fresh
# worktree, unattended, the moment an eligible task appears.
WISSEL_ORCHESTRATOR=
