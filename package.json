{
  "name": "wissel",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Routes tasks to a fleet of agents and skills.",
  "scripts": {
    "dev": "bun run --watch src/api/server.ts",
    "serve": "bun run build:editor && bun run build:app && bun run src/api/server.ts",
    "build:editor": "cd pipeline-editor && npm run build",
    "build:app": "cd app && npm run build",
    "agents": "bun run src/cli.ts agents",
    "why": "bun run src/cli.ts why",
    "team": "bun run src/cli.ts team",
    "version": "bun run src/cli.ts --version",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "test:e2e": "playwright test",
    "live-check:shutdown": "bun test scripts/live-check-shutdown.test.ts",
    "live-check:sandbox": "bun test scripts/live-check-sandbox.test.ts",
    "denials:baseline": "bun run scripts/denials-baseline.ts",
    "eval:sandbox-denials": "bun run eval/sandbox-denials.eval.ts",
    "test:e2e:affected": "bun run scripts/e2e-affected.ts --run",
    "seed:ai-news": "bun run scripts/seed-ai-news-pipeline.ts",
    "seed:schedules": "bun run scripts/seed-schedules.ts",
    "models:refresh": "bun run scripts/refresh-models-once.ts",
    "check:news-run": "bun run scripts/check-news-run.ts",
    "eval:ai-news": "bun run eval/ai-news-podcast.eval.ts",
    "eval:world-news": "bun run eval/ai-news-podcast.eval.ts --world",
    "eval:wissel-retro": "bun run eval/wissel-retro-podcast.eval.ts",
    "eval:readonly": "bun run eval/readonly.eval.ts",
    "eval:concierge": "bun run eval/concierge.eval.ts",
    "eval:ask-schedules": "bun run eval/ask-schedules.eval.ts",
    "eval:stt": "bun run eval/stt.eval.ts",
    "eval:implementer-reviewer": "bun run eval/implementer-reviewer.eval.ts",
    "eval:planner-subtask-plan": "bun run eval/planner-subtask-plan.eval.ts",
    "eval:pipeline-review-handoff": "bun run eval/pipeline-review-handoff.eval.ts",
    "eval:pipeline-full-lifecycle": "bun run eval/pipeline-full-lifecycle.eval.ts",
    "eval:pipeline-mcp-integration": "bun run eval/pipeline-mcp-integration.eval.ts",
    "eval:live-task-output": "bun run eval/live-task-output.eval.ts",
    "eval:conflict-integrator": "bun run eval/conflict-integrator.eval.ts",
    "eval:merge-gate": "bun run eval/merge-gate.eval.ts",
    "eval:memory-curation-quality": "bun run eval/memory-curation-quality.eval.ts",
    "eval:claude-cli-429-replay": "bun run eval/claude-cli-429-replay.eval.ts",
    "usage:report": "bun run scripts/usage-report.ts",
    "models:refresh": "bun run scripts/models-refresh.ts",
    "eval:resume": "bun run eval/resume.eval.ts",
    "eval:review-grants": "bun run eval/review-grants.eval.ts",
    "eval:remote-control": "bun run eval/remote-control.eval.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "croner": "10.0.1",
    "yaml": "^2.5.0"
  }
}
