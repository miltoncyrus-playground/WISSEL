{
  "name": "wissel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Routes tasks to a fleet of agents and skills.",
  "scripts": {
    "dev": "bun run --watch src/api/server.ts",
    "agents": "bun run src/cli.ts agents",
    "why": "bun run src/cli.ts why",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval:readonly": "bun run eval/readonly.eval.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  }
}
